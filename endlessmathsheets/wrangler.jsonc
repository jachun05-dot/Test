// Cloudflare Workers static-assets deploy (Workers & Pages > Import a repository).
// Build: npm run build  ·  Deploy: npx wrangler deploy  ·  Root directory: endlessmathsheets
{
  "name": "endlessmathsheets",
  "compatibility_date": "2026-06-01",
  // Serve only on the custom domain (added in the dashboard), so the same pages
  // are not also public on *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
