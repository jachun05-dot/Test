// Cloudflare Workers static-assets deploy (Workers & Pages > Import a repository).
// Build: npm run build  ·  Deploy: npx wrangler deploy  ·  Root directory: endlessmathsheets
{
  "name": "endlessmathsheets",
  "compatibility_date": "2026-06-01",
  // A tiny Worker redirects www to the bare domain; all pages are static files.
  "main": "src/worker.js",
  // Serve only on the custom domains, so the same pages are not also public on
  // *.workers.dev. Pages carry a canonical link to the bare domain.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "endlessmathsheets.com", "custom_domain": true },
    { "pattern": "www.endlessmathsheets.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
